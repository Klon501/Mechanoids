<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

	<!-- EN: Auto artillery -->
	<APM_Ravager_AutoArtillery_Label>自動火砲</APM_Ravager_AutoArtillery_Label>
	<!-- EN: Allow this ravager to automatically choose hostile pawns as artillery targets while under player control. Manual attack orders always fire once at the selected cell. -->
	<APM_Ravager_AutoArtillery_Desc>允許該破壞者在玩家控制下自動選擇敵對殖民者作為火砲目標。手動攻擊指令始終朝選定格子開火一次。</APM_Ravager_AutoArtillery_Desc>
	<!-- EN: Auto artillery: disabled. -->
	<APM_Ravager_Inspect_AutoArtilleryDisabled>自動火砲：已停用。</APM_Ravager_Inspect_AutoArtilleryDisabled>
	<!-- EN: Auto artillery: cannot fire from under a roof. -->
	<APM_Ravager_Inspect_AutoArtilleryBlockedRoof>自動火砲：無法在屋頂下開火。</APM_Ravager_Inspect_AutoArtilleryBlockedRoof>
	<!-- EN: Auto artillery: current target is under thick roof. -->
	<APM_Ravager_Inspect_AutoArtilleryBlockedTargetRoof>自動火砲：目前目標處於厚屋頂下。</APM_Ravager_Inspect_AutoArtilleryBlockedTargetRoof>
	<!-- EN: Auto artillery: current target cannot be hit from this position. -->
	<APM_Ravager_Inspect_AutoArtilleryCannotHit>自動火砲：從此位置無法擊中目前目標。</APM_Ravager_Inspect_AutoArtilleryCannotHit>

</LanguageData>
