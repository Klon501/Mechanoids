<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

	<!-- EN: Remote control uplink is active for {PAWN} -->
	<APM.CommandCasket.Inspection>遠端控制鏈路已對 {PAWN} 啟用</APM.CommandCasket.Inspection>
	<!-- EN: not mechanitor -->
	<APM.CommandCasket.FailReason.NotMechanitor>非機械師</APM.CommandCasket.FailReason.NotMechanitor>

	<!-- EN: Eject mechanitor -->
	<APM.CommandCasket.Gizmo.CancelLink.Label>彈出機械師</APM.CommandCasket.Gizmo.CancelLink.Label>
	<!-- EN: Cancel the remote link for the current occupant. The occupant will be ejected. -->
	<APM.CommandCasket.Gizmo.CancelLink.Desc>取消目前佔用者的遠端鏈路。佔用者將被彈出。</APM.CommandCasket.Gizmo.CancelLink.Desc>

	<!-- EN: remote shield -->
	<APM.CommandCasket.Gizmo.Shield.Label>遠端護盾</APM.CommandCasket.Gizmo.Shield.Label>
	<!-- EN: shield a friendly mechanoid, can target the whole map.\nPower scales with the remote shielder implant. -->
	<APM.CommandCasket.Gizmo.Shield.Desc>為友方機械體提供護盾，可指定整張地圖。\n護盾強度隨遠端護盾植入體提升。</APM.CommandCasket.Gizmo.Shield.Desc>
	<!-- EN: shield the selected mechanoid.\nPower scales with the remote shielder implant. -->
	<APM.CommandCasket.Gizmo.ShieldSelf.Desc>為所選機械體提供護盾。\n護盾強度隨遠端護盾植入體提升。</APM.CommandCasket.Gizmo.ShieldSelf.Desc>

	<!-- EN: remote repair -->
	<APM.CommandCasket.Gizmo.Repair.Label>遠端修復</APM.CommandCasket.Gizmo.Repair.Label>
	<!-- EN: repair a friendly mechanoid until it is fully repaired or has no energy remaining. Can target the whole map. -->
	<APM.CommandCasket.Gizmo.Repair.Desc>修復友方機械體直至完全修好或能量耗盡。可指定整張地圖。</APM.CommandCasket.Gizmo.Repair.Desc>
	<!-- EN: repair the selected mechanoid until it is fully repaired or has no energy remaining. -->
	<APM.CommandCasket.Gizmo.RepairSelf.Desc>修復所選機械體直至完全修好或能量耗盡。</APM.CommandCasket.Gizmo.RepairSelf.Desc>

	<!-- EN: remote disconnect -->
	<APM.CommandCasket.Gizmo.Disconnect.Label>遠端斷開</APM.CommandCasket.Gizmo.Disconnect.Label>
	<!-- EN: remotely disconnect from a controlled mech. Can target mechs on the same map. -->
	<APM.CommandCasket.Gizmo.Disconnect.Desc>遠端斷開與受控機甲的連接。可指定同一張地圖上的機甲。</APM.CommandCasket.Gizmo.Disconnect.Desc>

	<!-- EN: remote connect -->
	<APM.CommandCasket.Gizmo.Connect.Label>遠端連接</APM.CommandCasket.Gizmo.Connect.Label>
	<!-- EN: remotely connect to a friendly mech. Can target mechs on the same map. Time depends on the targeted mechanoid. -->
	<APM.CommandCasket.Gizmo.Connect.Desc>遠端連接到友方機甲。可指定同一張地圖上的機甲。耗時取決於目標機械體。</APM.CommandCasket.Gizmo.Connect.Desc>

	<!-- EN: bandwidth used: -->
	<APM.CommandCasket.Inspection.Bandwidth>佔用頻寬：</APM.CommandCasket.Inspection.Bandwidth>

	<!-- EN: remote reconnect -->
	<APM.CommandCasket.Mech.Gizmo.Reconnect.Label>遠端重連</APM.CommandCasket.Mech.Gizmo.Reconnect.Label>
	<!-- EN: remotely connect this mech to a mechanitor inside a mech command casket. -->
	<APM.CommandCasket.Mech.Gizmo.Reconnect.Desc>將此機甲遠端連接到機械指揮艙內的機械師。</APM.CommandCasket.Mech.Gizmo.Reconnect.Desc>

	<!-- EN:  (missing bandwidth) -->
	<APM.CommandCasket.Mech.Gizmo.Reconnect.Floatmenu>（頻寬不足）</APM.CommandCasket.Mech.Gizmo.Reconnect.Floatmenu>

	<!-- EN: currently -->
	<APM.CommandCasket.Inspect.CurrentAction>目前</APM.CommandCasket.Inspect.CurrentAction>

	<!-- EN: connecting -->
	<APM.CommandCasket.Inspect.CurrentAction.Connect>連接中</APM.CommandCasket.Inspect.CurrentAction.Connect>

	<!-- EN: disconnecting -->
	<APM.CommandCasket.Inspect.CurrentAction.Disconnect>斷開中</APM.CommandCasket.Inspect.CurrentAction.Disconnect>

	<!-- EN: shielding -->
	<APM.CommandCasket.Inspect.CurrentAction.Shield>護盾中</APM.CommandCasket.Inspect.CurrentAction.Shield>

	<!-- EN: repairing -->
	<APM.CommandCasket.Inspect.CurrentAction.Repair>修復中</APM.CommandCasket.Inspect.CurrentAction.Repair>

	<!-- EN: idle -->
	<APM.CommandCasket.Inspect.CurrentAction.Idle>閒置</APM.CommandCasket.Inspect.CurrentAction.Idle>

	<!-- EN: \nLeftclick = choose target\nShift = target self\nCtrl = que action\nRightclick = cancel -->
	<APM.CommandCasket.Gizmo.ControlsInfo>\n左鍵 = 選擇目標\nShift = 指定自身\nCtrl = 排隊動作\n右鍵 = 取消</APM.CommandCasket.Gizmo.ControlsInfo>

</LanguageData>
