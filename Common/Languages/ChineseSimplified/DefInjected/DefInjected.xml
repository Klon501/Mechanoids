  <!-- EN: Defence Matrix -->
  <APM_DefenceMatrix.label>防御矩阵</APM_DefenceMatrix.label>

  <!-- EN: Project a personal defense shield onto a same-faction pawn. The shield stops incoming damage and prevents the target from shooting out. -->
