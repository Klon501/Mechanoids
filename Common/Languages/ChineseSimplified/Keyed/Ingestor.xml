<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- EN: Enable stripping -->
  <APM_Ingestor_StripMode_Enable_Label>启用剥离</APM_Ingestor_StripMode_Enable_Label>
  <!-- EN: Click to strip apparel, equipment and inventory from corpses before recycling them. Current mode: recycle corpses intact; carried items are destroyed with the corpse. -->
  <APM_Ingestor_StripMode_Enable_Desc>点击以在回收尸体前剥离其衣物、装备与随身物品。当前模式：尸体完整回收，携带物品随尸体一起销毁。</APM_Ingestor_StripMode_Enable_Desc>
  <!-- EN: Disable stripping -->
  <APM_Ingestor_StripMode_Disable_Label>停用剥离</APM_Ingestor_StripMode_Disable_Label>
  <!-- EN: Click to recycle corpses intact and destroy apparel, equipment and inventory with the corpse. Current mode: strip carried items before recycling. -->
  <APM_Ingestor_StripMode_Disable_Desc>点击以完整回收尸体并将衣物、装备与随身物品随尸体一起销毁。当前模式：回收前先剥离携带物品。</APM_Ingestor_StripMode_Disable_Desc>
  <!-- EN: Recycle all valid corpses -->
  <APM_Ingestor_ProcessMode_All_Label>回收所有有效尸体</APM_Ingestor_ProcessMode_All_Label>
  <!-- EN: Click to let the ingestor recycle any reachable fresh organic corpse. Current mode: only marked corpses are recycled. -->
  <APM_Ingestor_ProcessMode_All_Desc>点击以让摄入者回收任何可到达的新鲜有机尸体。当前模式：仅回收被标记的尸体。</APM_Ingestor_ProcessMode_All_Desc>
  <!-- EN: Use marked corpses only -->
  <APM_Ingestor_ProcessMode_Marked_Label>仅使用被标记的尸体</APM_Ingestor_ProcessMode_Marked_Label>
  <!-- EN: Click to make the ingestor recycle only corpses marked for biomass recycling. Current mode: all reachable fresh organic corpses are recycled. -->
  <APM_Ingestor_ProcessMode_Marked_Desc>点击以让摄入者仅回收被标记为生物质回收的尸体。当前模式：回收所有可到达的新鲜有机尸体。</APM_Ingestor_ProcessMode_Marked_Desc>
  <!-- EN: Mark for biomass recycling -->
  <APM_Ingestor_MarkCorpses_Label>标记为生物质回收</APM_Ingestor_MarkCorpses_Label>
  <!-- EN: Mark fresh organic corpses for ingestor recycling. -->
  <APM_Ingestor_MarkCorpses_Desc>将新鲜有机尸体标记为摄入者回收目标。</APM_Ingestor_MarkCorpses_Desc>
  <!-- EN: Must target a fresh organic corpse. -->
  <APM_IngestorAbsorb_MustTargetCorpse>必须选择新鲜有机尸体。</APM_IngestorAbsorb_MustTargetCorpse>
  <!-- EN: Must target a fresh organic corpse or ingestible material. -->
  <APM_IngestorAbsorb_InvalidTarget>必须选择新鲜有机尸体或可被摄入的材料。</APM_IngestorAbsorb_InvalidTarget>
  <!-- EN: Invalid corpse. -->
  <APM_IngestorAbsorb_InvalidCorpse>无效尸体。</APM_IngestorAbsorb_InvalidCorpse>
  <!-- EN: Target is not organic biomass. -->
  <APM_IngestorAbsorb_NotOrganic>目标不是有机生物质。</APM_IngestorAbsorb_NotOrganic>
  <!-- EN: Cannot recycle a burning corpse. -->
  <APM_IngestorAbsorb_Burning>无法回收燃烧的尸体。</APM_IngestorAbsorb_Burning>
  <!-- EN: Cannot recycle a rotted or desiccated corpse. -->
  <APM_IngestorAbsorb_NotFresh>无法回收腐烂或风干的尸体。</APM_IngestorAbsorb_NotFresh>
  <!-- EN: Already marked for biomass recycling. -->
  <APM_IngestorAbsorb_AlreadyMarked>已标记为生物质回收。</APM_IngestorAbsorb_AlreadyMarked>
  <!-- EN: {0} {1} in {2} -->
  <APM_IngestorBiomass_LabelSingle>{0} {1}，位于 {2}</APM_IngestorBiomass_LabelSingle>
  <!-- EN: {0} batches, {1} {2}, next in {3} -->
  <APM_IngestorBiomass_LabelMultiple>{0} 批，{1} {2}，下一波在 {3}</APM_IngestorBiomass_LabelMultiple>
  <!-- EN: Pending output: -->
  <APM_IngestorBiomass_TooltipHeader>待产出：</APM_IngestorBiomass_TooltipHeader>
  <!-- EN: {0} {1} in {2} -->
  <APM_IngestorBiomass_TooltipBatch>{0} {1}，位于 {2}</APM_IngestorBiomass_TooltipBatch>
  <!-- EN: ...and {0} more. -->
  <APM_IngestorBiomass_TooltipMore>{0}另有 {0} 项。</APM_IngestorBiomass_TooltipMore>
  <!-- EN: unknown output -->
  <APM_IngestorBiomass_UnknownOutput>未知产出</APM_IngestorBiomass_UnknownOutput>
</LanguageData>
