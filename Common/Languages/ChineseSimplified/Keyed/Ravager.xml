<LanguageData>

	<!-- EN: Auto artillery -->
	<APM_Ravager_AutoArtillery_Label>自动火炮</APM_Ravager_AutoArtillery_Label>
	<!-- EN: Allow this ravager to automatically choose hostile pawns as artillery targets while under player control. Manual attack orders always fire once at the selected cell. -->
	<APM_Ravager_AutoArtillery_Desc>允许该破坏者在玩家控制下自动选择敌对殖民者作为火炮目标。手动攻击指令始终朝选定格子开火一次。</APM_Ravager_AutoArtillery_Desc>
	<!-- EN: Auto artillery: disabled. -->
	<APM_Ravager_Inspect_AutoArtilleryDisabled>自动火炮：已禁用。</APM_Ravager_Inspect_AutoArtilleryDisabled>
	<!-- EN: Auto artillery: cannot fire from under a roof. -->
	<APM_Ravager_Inspect_AutoArtilleryBlockedRoof>自动火炮：无法在屋顶下开火。</APM_Ravager_Inspect_AutoArtilleryBlockedRoof>
	<!-- EN: Auto artillery: current target is under thick roof. -->
	<APM_Ravager_Inspect_AutoArtilleryBlockedTargetRoof>自动火炮：当前目标处于厚屋顶下。</APM_Ravager_Inspect_AutoArtilleryBlockedTargetRoof>
	<!-- EN: Auto artillery: current target cannot be hit from this position. -->
	<APM_Ravager_Inspect_AutoArtilleryCannotHit>自动火炮：从此位置无法击中当前目标。</APM_Ravager_Inspect_AutoArtilleryCannotHit>

</LanguageData>
