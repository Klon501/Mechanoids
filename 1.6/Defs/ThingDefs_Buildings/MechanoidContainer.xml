		<uiIconScale>0.95</uiIconScale>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsSpecial</li>
		</thingCategories>
		<!-- Not buildable. The cost is what deconstructing one gives back. -->
