<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef Abstract="True" Name="APM_MechanoidContainerBase" ParentName="BuildingBase">
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<canOverlapZones>false</canOverlapZones>
		<pathCost>42</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>0.5</fillPercent>
		<statBases>
			<MaxHitPoints>800</MaxHitPoints>
			<WorkToBuild>1000</WorkToBuild>
			<Mass>70</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<size>(2, 2)</size>
		<tickerType>Normal</tickerType>
		<dontPrint>true</dontPrint>
		<hasInteractionCell>false</hasInteractionCell>
		<building>
			<paintable>false</paintable>
			<destroySound>BuildingDestroyed_Metal_Small</destroySound>
			<buildingTags>
				<li>Biotech</li>
			</buildingTags>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
	</ThingDef>


	<ThingDef ParentName="APM_MechanoidContainerBase">
		<defName>APM_MechanoidContainer_Cluster</defName>
		<label>ancient mechanoid stasis container</label>
		<description>A heavy container equipped with autonomous activity-maintenance systems and archaic telemetry screens. Judging by the internal sensors, the mechanoid sealed inside was isolated from the hive mind immediately after its creation. The device is in deep preservation mode. Its mechanisms do not respond to external access codes, but the isolation saved the machine from forced deactivation. By breaking open this container, one can attempt to seize control of the forgotten mechanoid contained within.</description>
		<graphicData>
			<texPath>Things/Building/MechanoidContainer/MechanoidContainerCluster</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2, 3)</drawSize>
			<drawOffset>(0,0,0.5)</drawOffset>
			<shadowData>
				<volume>(1.8, 1.8, 0.7)</volume>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/MechanoidContainer/MechanoidContainerCluster</uiIconPath>
		<uiIconScale>0.95</uiIconScale>
		<building>
			<buildingTags>
				<li>MechanoidClusterBuilding</li>
				<li>MechClusterMember</li>
			</buildingTags>
			<minMechClusterPoints>500</minMechClusterPoints>
			<claimable>false</claimable>
			<deconstructible>false</deconstructible>
		</building>
		<modExtensions>
			<!--
				Rare on purpose. One slot per cluster, never below 500 point clusters, and the chance
				climbs with the cluster: a token 500 point cluster keeps the old 8%, while the ones
				worth bringing an army to are better than even money.
			-->
			<li Class="ApexMechanoids.DefModExtension_MechClusterExtra">
				<minTotalPoints>500</minTotalPoints>
				<maxPerCluster>1</maxPerCluster>
				<spawnChanceByTotalPoints>
					<points>
						<li>(500, 0.08)</li>
						<li>(1500, 0.22)</li>
						<li>(3000, 0.40)</li>
						<li>(6000, 0.60)</li>
					</points>
				</spawnChanceByTotalPoints>
			</li>
		</modExtensions>
		<comps>
			<li Class="ApexMechanoids.CompProperties_MechanoidContainer">
				<activeTicks>120</activeTicks>
				<ticksToActivate>5000</ticksToActivate>
				<!-- <cooldownTicks>20000</cooldownTicks> -->
				<activateTexPath>UI/Gizmos/MechControlGroup</activateTexPath>
        
				<activateLabelString>Hack</activateLabelString>
				<activateDescString>Will hack container to reprogram mechanoid inside.</activateDescString>
				<guiLabelString>Choose who should hack this.</guiLabelString>
				<jobString>hack container</jobString>
				<activatingStringPending>hacking {0}</activatingStringPending>
				<activatingString>hacking {0}: {1}s</activatingString>
				<onCooldownString>recalibrating</onCooldownString>
				<!-- <messageCooldownEnded>Can hack again.</messageCooldownEnded> -->

				<!-- <fleckOnUsed>PsycastAreaEffect</fleckOnUsed> -->
				<!-- <fleckOnUsedScale>5</fleckOnUsedScale> -->
				<soundActivate>GestatorGlassShattered</soundActivate>
				<interactionEffecter>Hacking</interactionEffecter>

				<targetingParameters>
					<canTargetBuildings>false</canTargetBuildings>
					<canTargetAnimals>false</canTargetAnimals>
					<canTargetMechs>false</canTargetMechs>
					<onlyTargetControlledPawns>true</onlyTargetControlledPawns>
				</targetingParameters>
				
				<!-- Weights are the roll inside whatever the points band below has left available. -->
				<mechKindOptions>
					<Mech_Militor MayRequire="Ludeon.RimWorld.Biotech">10</Mech_Militor>
					<Mech_Scorcher MayRequire="Ludeon.RimWorld.Biotech">10</Mech_Scorcher>
					<APM_Mech_Tinker>8</APM_Mech_Tinker>
					<Mech_Pikeman>8</Mech_Pikeman>
					<Mech_Cyclops MayRequire="Ludeon.RimWorld.Odyssey">8</Mech_Cyclops>
					<APM_Mech_Haze>8</APM_Mech_Haze>
					<Mech_Scyther>8</Mech_Scyther>
					<Mech_Tesseron MayRequire="Ludeon.RimWorld.Biotech">8</Mech_Tesseron>
					<APM_Mech_Lasher>6</APM_Mech_Lasher>
					<Mech_Lancer>6</Mech_Lancer>
					<APM_Mech_Conqueror_DMR>3</APM_Mech_Conqueror_DMR>
					<APM_Mech_Conqueror_AR>3</APM_Mech_Conqueror_AR>
					<APM_Mech_Conqueror_LMG>3</APM_Mech_Conqueror_LMG>
					<APM_Mech_Frostivus>5</APM_Mech_Frostivus>
					<APM_Mech_Siren>5</APM_Mech_Siren>
					<APM_Mech_Pulse>4</APM_Mech_Pulse>
					<APM_Mech_Vassal>4</APM_Mech_Vassal>
					<Mech_Tunneler MayRequire="Ludeon.RimWorld.Biotech">4</Mech_Tunneler>
					<Mech_Centurion MayRequire="Ludeon.RimWorld.Biotech">3</Mech_Centurion>
					<APM_Mech_Dynamo>3</APM_Mech_Dynamo>
					<APM_Mech_Ravager>3</APM_Mech_Ravager>
					<APM_Mech_Mantis>3</APM_Mech_Mantis>
					<APM_Mech_Ingestor>3</APM_Mech_Ingestor>
					<APM_Mech_Javelin>3</APM_Mech_Javelin>
					<Mech_CentipedeBlaster>2</Mech_CentipedeBlaster>
					<Mech_CentipedeBurner>2</Mech_CentipedeBurner>
					<Mech_CentipedeGunner>2</Mech_CentipedeGunner>
					<APM_Mech_Aegis>2</APM_Mech_Aegis>
				</mechKindOptions>
				<!--
					Anything else a mechanitor could have gestated for itself, ours or another mod's,
					joins the roll at a flat weight. The list above stays the curated core.
				-->
				<!-- Fighting mechs only. The work drones gestate the same way and are not a prize. -->
				<autoIncludeControllableMechs>true</autoIncludeControllableMechs>
				<autoIncludeWeight>2</autoIncludeWeight>
				<!--
					Bosses are not a prize for opening a crate, and the Satellite does not spawn on its
					own. The points ceiling already keeps all of these out; naming them means raising
					that ceiling later cannot let them back in by accident.
				-->
				<excludedMechKinds>
					<li>APM_Mech_Satellite</li>
					<li>APM_Mech_Maul</li>
					<li>APM_Mech_Celerus</li>
					<li>APM_Mech_Dominus</li>
					<li>APM_Mech_Terminus</li>
					<li>APM_Mech_Gazer</li>
				</excludedMechKinds>
				<!--
					Colony threat points to the highest combatPower this container may hold.
					80 covers militor and scorcher, 150 adds pikeman, cyclops, scyther, tesseron, tinker
					and haze, 250 adds lancer, tunneler, centurion, lasher, conqueror, frostivus, siren,
					pulse and vassal, 400 opens up the centipedes and our heavies.
				-->
				<maxCombatPowerByThreatPoints>
					<points>
						<li>(0, 80)</li>
						<li>(350, 150)</li>
						<li>(800, 250)</li>
						<li>(1600, 400)</li>
					</points>
				</maxCombatPowerByThreatPoints>
				<!--
					And the lowest. The ceiling alone only ever widens the pool, so a colony with a few
					million in wealth kept rolling militors and scythers because those carry the heavy
					weights. This walks the floor up behind it, so the container tracks the colony
					instead of trailing it.
				-->
				<minCombatPowerByThreatPoints>
					<points>
						<li>(0, 0)</li>
						<li>(500, 0)</li>
						<li>(1000, 110)</li>
						<li>(1800, 190)</li>
						<li>(3000, 300)</li>
					</points>
				</minCombatPowerByThreatPoints>
				<emptyGraphic>
					<texPath>Things/Building/MechanoidContainer/MechanoidContainerCluster_Empty</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(2, 3)</drawSize>
					<drawOffset>(0,0,0.5)</drawOffset>
					<shadowData>
						<volume>(1.8, 1.8, 0.7)</volume>
					</shadowData>
				</emptyGraphic>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>4</glowRadius>
				<glowColor>(255,150,100,0)</glowColor>
			</li>
		</comps>
	</ThingDef>


	<ThingDef ParentName="APM_MechanoidContainerBase">
		<defName>APM_MechanoidContainer_Player</defName>
		<label>mechanoid stasis container</label>
		<description>A specialized stasis container designed for the safe storage of mechanoids. Placing a mechanoid inside completely severs its active neural link with the mechanitor and puts its systems into deep suspended animation. In this state, the machine consumes no power and does not occupy the mechanitor's bandwidth, freeing up valuable network resources. The container allows you to keep an assault or worker squad in reserve, ready for deployment at a moment's notice without risking network overload.</description>
		<graphicData>
			<texPath>Things/Building/MechanoidContainer/MechanoidContainer</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2, 3)</drawSize>
			<drawOffset>(0,0,0.5)</drawOffset>
			<shadowData>
				<volume>(1.8, 1.8, 0.7)</volume>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/MechanoidContainer/MechanoidContainer</uiIconPath>
		<uiIconScale>0.95</uiIconScale>
		<designationCategory>Biotech</designationCategory>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsSpecial</li>
		</thingCategories>
		<costList>
			<Steel>150</Steel>
			<Plasteel>50</Plasteel>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<researchPrerequisites>
