				<guiLabelString>Choose who should open this.</guiLabelString>
				<jobString>extract</jobString>
				<activatingStringPending>extracting from {0}</activatingStringPending>
				<activatingString>extracting from {0}: {1}s</activatingString>
				<onCooldownString>recalibrating</onCooldownString>
				<!-- <messageCooldownEnded>Can hack again.</messageCooldownEnded> -->

				<!-- <fleckOnUsed>PsycastAreaEffect</fleckOnUsed> -->
				<!-- <fleckOnUsedScale>5</fleckOnUsedScale> -->
				<soundActivate>GestatorGlassShattered</soundActivate>
				<interactionEffecter>Hacking</interactionEffecter>

				<targetingParameters>
					<canTargetBuildings>false</canTargetBuildings>
					<canTargetAnimals>false</canTargetAnimals>
					<canTargetMechs>false</canTargetMechs>
					<onlyTargetControlledPawns>true</onlyTargetControlledPawns>
				</targetingParameters>
				
				<enterJobDef>APM_EnterMechanoidContainer</enterJobDef>
				<ChooseMechLabel>Choose mechanoid</ChooseMechLabel>
				<ChooseMechDesc>Instruct mechanoid to enter stasis.</ChooseMechDesc>
				<emptyGraphic>
					<texPath>Things/Building/MechanoidContainer/MechanoidContainer_Empty</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(2, 3)</drawSize>
					<drawOffset>(0,0,0.5)</drawOffset>
					<shadowData>
						<volume>(1.8, 1.8, 0.7)</volume>
					</shadowData>
				</emptyGraphic>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>4</glowRadius>
				<glowColor>(255,150,100,0)</glowColor>
			</li>
		</comps>
	</ThingDef>


	<!--
		The same human built container as it is found rather than built, and the only one the ruin
		prefab places. It is its own def rather than a flag on the one above because the one above is
		placed by three different routes - the architect menu, the Buried Legacy starting structure,
		and hauling a minified one back down - and none of those should hand out a mech. A separate
		def cannot be got wrong by any of them.

		Everything else about it matches: claim it, use it, uninstall it and haul it home, or
		deconstruct it for the steel, plasteel and components.

		The occupant is generated on opening rather than stored, which matters here: this thing runs
		on 150W and drops whatever it is holding the moment the power does, and nothing in a ruin has
		power.
	-->
