	<!--
		The containers standing in the dead mechanitor's base at the start of Buried Legacy. One def
		per mech, because a KCSG layout cell names a def and nothing else, so that is the only place
		the choice can live.

		Like the one found in a ruin, the occupant is generated when the container is opened rather
		than stored: the base has no power until the player restores it, and a stored mech is dropped
		on the floor the moment the 150W stops. It is not buildable either; the cost list is what
		deconstructing one gives back.

		The occupant is not named on the container. The client asked for that on 2026-08-12 and it
		holds here too, even though these are the same three every run.
	-->
	<ThingDef Abstract="True" Name="APM_MechanoidContainer_LegacyBase" ParentName="APM_MechanoidContainerBase">
		<label>sealed mechanoid stasis container</label>
		<description>One of the stasis containers of the domain's own garrison, still sealed and still turning over its preservation cycle on the last of the reserves. The mechanitor who filled it is long dead and the neural link it answered to died with him, so whoever breaks the seal can claim what steps out.</description>
		<graphicData>
			<texPath>Things/Building/MechanoidContainer/MechanoidContainer</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2, 3)</drawSize>
			<drawOffset>(0,0,0.5)</drawOffset>
			<shadowData>
				<volume>(1.8, 1.8, 0.7)</volume>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/MechanoidContainer/MechanoidContainer</uiIconPath>
		<uiIconScale>0.95</uiIconScale>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsSpecial</li>
		</thingCategories>
		<costList>
			<Steel>150</Steel>
			<Plasteel>50</Plasteel>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<building>
			<destroySound>BuildingDestroyed_Metal_Medium</destroySound>
		</building>
	</ThingDef>

	<ThingDef ParentName="APM_MechanoidContainer_LegacyBase">
		<defName>APM_MechanoidContainer_Legacy_Lasher</defName>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>150</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="ApexMechanoids.CompProperties_MechanoidContainerControlled">
				<activeTicks>120</activeTicks>
				<ticksToActivate>5000</ticksToActivate>
				<cooldownTicks>20000</cooldownTicks>
				<activateTexPath>UI/Gizmos/MechControlGroup</activateTexPath>

				<activateLabelString>Hack</activateLabelString>
