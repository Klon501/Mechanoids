<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BaseMechanoidWalker">
		<defName>APM_Mech_Javelin</defName>
		<label>javelin</label>
		<description>While standard mechanoids rely on direct ballistic impacts, the Javelin acts as a mobile missile launcher utilizing semi-autonomous micro-missile mechanics. Instead of a conventional payload, it fires tiny self-guided missile-mechanoids that cruise slowly toward their target with built-in homing capabilities.\n\nThe Javelin is equipped with a switchable missile system; while its basic rockets apply a stacking vulnerable hediff with every consecutive hit against heavy armor, specialized warheads require raw uranium to fire - allowing it to unleash devastating HE blasts, wide-area incendiary explosions, or crippling EMP pulses depending on the tactical situation.</description>
		<statBases>
			<MarketValue>1800</MarketValue>
			<MoveSpeed>2.5</MoveSpeed>
			<ArmorRating_Blunt>0.22</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.55</ArmorRating_Sharp>
			<ArmorRating_Heat>2.0</ArmorRating_Heat>
			<BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">3</BandwidthCost>
			<MechEnergyLossPerHP MayRequire="Ludeon.Rimworld.Biotech">0.2</MechEnergyLossPerHP>
			<ControlTakingTime MayRequire="Ludeon.RimWorld.Biotech">18</ControlTakingTime>
		</statBases>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>12</power>
				<cooldownTime>2.0</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
		</tools>
		<race>
			<body>APM_Javelin</body>
			<baseBodySize>3.0</baseBodySize>
			<baseHealthScale>2.42</baseHealthScale>
			<!-- Medium to match the 3 bandwidth cost and the medium gestator recipe this mech
			     already ships with; Heavy mechs cost 6 bandwidth in vanilla. -->
			<mechWeightClass>Medium</mechWeightClass>
			<lifeStageAges Inherit="False">
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
					<soundWounded>Pawn_Mech_Legionary_Wounded</soundWounded>
					<soundDeath>Pawn_Mech_Legionary_Death</soundDeath>
					<soundCall>Pawn_Mech_Legionary_Call</soundCall>
				</li>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>100</minAge>
					<soundWounded>Pawn_Mech_Legionary_Wounded</soundWounded>
					<soundDeath>Pawn_Mech_Legionary_Death</soundDeath>
					<soundCall>Pawn_Mech_Legionary_Call</soundCall>
				</li>
			</lifeStageAges>
			<detritusLeavings>
				<li>
					<def>ChunkMechanoidSlag</def>
					<texOverrideIndex>16</texOverrideIndex>
					<spawnChance>0.1</spawnChance>
				</li>
				<li>
					<def>ChunkMechanoidSlag</def>
					<texOverrideIndex>11</texOverrideIndex>
					<spawnChance>0.1</spawnChance>
				</li>
				<li>
					<def>ChunkMechanoidSlag</def>
					<texOverrideIndex>1</texOverrideIndex>
					<spawnChance>0.1</spawnChance>
				</li>
			</detritusLeavings>
		</race>
		<comps>
			<li Class="CompProperties_WasteProducer">
				<showContentsInInspectPane>false</showContentsInInspectPane>
			</li>
			<li Class="CompProperties_ThingContainer">
				<compClass>CompThingContainer</compClass>
				<stackLimit>100</stackLimit>
				<drawContainedThing>false</drawContainedThing>
				<dropEffecterDef>MechChargerWasteRemoved</dropEffecterDef>
			</li>
			<!--
				The rocket magazine. Uranium rather than a bespoke ammo item so loading it is
				ordinary hauling work and needs no job of its own, which is the same arrangement the
				dynamo already uses for its own uranium. Nothing is drawn while the mech is standing
				around: consumeFuelOnlyWhenUsed switches the passive drain off entirely, and the only
				thing that ever spends from here is a shot leaving the tube (CompJavelinRocketRack).

				30 is a magazine of roughly six to ten of the paid warheads. A javelin that runs it
				dry is not disarmed - it drops back to the free basic rocket - so this is how long
				the mech gets to fight with the warhead the player chose, not how long it can fight.
			-->
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>0</fuelConsumptionRate>
				<fuelCapacity>60.0</fuelCapacity>
				<initialFuelPercent>0</initialFuelPercent>
				<fuelFilter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</fuelFilter>
				<fuelLabel>Rocket uranium</fuelLabel>
				<fuelGizmoLabel>Rocket uranium</fuelGizmoLabel>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
				<allowRefuelIfNotEmpty>true</allowRefuelIfNotEmpty>
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<initialConfigurableTargetFuelLevel>60.0</initialConfigurableTargetFuelLevel>
				<canEjectFuel>true</canEjectFuel>
				<!-- A mech with an empty magazine is still a working mech, so it gets none of the
				     out-of-fuel furniture: no overlay, no gauge on the map, and no gizmos at all on
				     a launcher the player does not own. -->
				<drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
				<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
				<hideGizmosIfNotPlayerFaction>true</hideGizmosIfNotPlayerFaction>
			</li>
			<!--
				The four warheads behind the switch gizmo. Order matters: the first is what the rack
				falls back to when it cannot pay for anything else, so it has to be the free one.
				Costs are per shot, drawn from the magazine above, and only the player is charged -
				a raid has no stockpile to haul from, so an enemy javelin is handed one of the
				non-playerOnly warheads when it spawns and fires it for nothing.
			-->
			<li Class="ApexMechanoids.CompProperties_JavelinRocketRack">
				<rockets>
					<li>
						<key>basic</key>
						<projectile>APM_Proj_JavelinMissile</projectile>
						<label>basic rocket</label>
						<description>A shaped tank-killer warhead. Free, and the only one whose seeker logs its target: every rocket that finds the same one again bites deeper than the last.</description>
						<uraniumCost>0</uraniumCost>
					</li>
					<li>
						<key>incendiary</key>
						<projectile>APM_Proj_JavelinMissile_Incendiary</projectile>
						<label>incendiary rocket</label>
						<description>Sprays burning fuel across the impact point and sets light to whatever is standing in it. Poor against armour.</description>
						<uraniumCost>10</uraniumCost>
					</li>
					<li>
						<key>highExplosive</key>
						<projectile>APM_Proj_JavelinMissile_HighExplosive</projectile>
						<label>high-explosive rocket</label>
						<description>A fragmentation warhead with a wide blast. Tears through a crowd of lightly armoured targets, and does far less to a single heavy one than the basic rocket would.</description>
						<uraniumCost>25</uraniumCost>
					</li>
					<li>
						<key>emp</key>
						<projectile>APM_Proj_JavelinMissile_EMP</projectile>
						<label>EMP rocket</label>
						<description>An electromagnetic pulse that stuns machines outright and barely marks flesh. Mechanoid raids do not field this one.</description>
						<uraniumCost>15</uraniumCost>
						<playerOnly>true</playerOnly>
					</li>
				</rockets>
			</li>
		</comps>
		<butcherProducts>
			<Steel>40</Steel>
			<Plasteel>10</Plasteel>
		</butcherProducts>
	</ThingDef>

	<PawnKindDef ParentName="BaseMechanoidKind">
		<defName>APM_Mech_Javelin</defName>
		<label>javelin</label>
		<race>APM_Mech_Javelin</race>
		<combatPower>350</combatPower>
		<allowInMechClusters>true</allowInMechClusters>
		<lifeStages>
			<li MayRequire="Ludeon.RimWorld.Biotech">
				<bodyGraphicData>
					<texPath>Things/Pawn/Mechanoid/Javelin/Javelin</texPath>
					<maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Javelin/Mech_Javelin</maskPath>
					<shaderType>CutoutWithOverlay</shaderType>
					<drawSize>3</drawSize>
					<shadowData>
						<volume>(0.6, 0.8, 0.6)</volume>
						<offset>(0, 0, -0.3)</offset>
					</shadowData>
				</bodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<texPath>Things/Pawn/Mechanoid/Javelin/JavelinAncient</texPath>
					<maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Javelin/Mech_Javelin</maskPath>
					<shaderType>CutoutWithOverlay</shaderType>
					<drawSize>3</drawSize>
					<shadowData>
						<volume>(0.6, 0.8, 0.6)</volume>
						<offset>(0, 0, -0.3)</offset>
					</shadowData>
				</bodyGraphicData>
			</li>
		</lifeStages>
		<weaponMoney>9999~9999</weaponMoney>
		<weaponTags>
			<li>APM_WeaponJavelinRocketLauncher</li>
		</weaponTags>
		<techHediffsChance>1</techHediffsChance>
		<techHediffsMoney>9999~9999</techHediffsMoney>
		<controlGroupPortraitZoom>0.85</controlGroupPortraitZoom>
	</PawnKindDef>
</Defs>