<?xml version="1.0" encoding="utf-8"?>
<Defs>

<!--
  KCSG writes a symbol of its own for every ThingDef of Core and the DLCs, which is why the layouts
  can say Wall_BlocksGranite with nothing declared for it. It does not do that for any other mod, so
  each of ours needs one here.

  The rotation suffix is not a second way out. An unknown APM_Foo_North sends KCSG to
  HotGenerateRotationSymbols, which strips the suffix and looks the remainder up among the symbols,
  not among the things; with no APM_Foo symbol it hands back an empty one, and SymbolUtils.Generate
  returns on the null thingDef without a word. The cell just stays bare.

  So the entries below are unrotated on purpose: one symbol per thing covers every rotation the
  layouts ask for.
-->

<KCSG.SymbolDef>
  <defName>APM_MechanoidContainer_Player</defName>
  <thing>APM_MechanoidContainer_Player</thing>
</KCSG.SymbolDef>

<KCSG.SymbolDef>
  <defName>APM_MechanoidContainer_Legacy_Lasher</defName>
  <thing>APM_MechanoidContainer_Legacy_Lasher</thing>
</KCSG.SymbolDef>

<KCSG.SymbolDef>
  <defName>APM_MechanoidContainer_Legacy_Vassal</defName>
  <thing>APM_MechanoidContainer_Legacy_Vassal</thing>
</KCSG.SymbolDef>

<KCSG.SymbolDef>
  <defName>APM_MechanoidContainer_Legacy_Tinker</defName>
  <thing>APM_MechanoidContainer_Legacy_Tinker</thing>
</KCSG.SymbolDef>

<KCSG.SymbolDef>
  <defName>APM_RepairStation_Small</defName>
  <thing>APM_RepairStation_Small</thing>
</KCSG.SymbolDef>

<!--
  Vanilla thing, but the layout asks for it under an exported name carrying a charge level, and KCSG
  only auto-creates the plain Battery and Battery_South. Two of these stand in Domain 1.
-->
<KCSG.SymbolDef>
  <defName>Battery_South_Power0</defName>
  <thing>Battery</thing>
  <rotation>South</rotation>
  <powerPercent>0</powerPercent>
</KCSG.SymbolDef>

<KCSG.SymbolDef>
  <defName>APM_MechCommandCasket_South</defName>
  <thing>APM_MechCommandCasket</thing>
  <rotation>South</rotation>
</KCSG.SymbolDef>

  <KCSG.SymbolDef>
    <defName>APM_RepairStation_Small_South</defName>
    <thing>APM_RepairStation_Small</thing>
    <rotation>South</rotation>
  </KCSG.SymbolDef>

  <KCSG.SymbolDef>
    <defName>APM_Weapon_PlasmaWhip</defName>
    <thing>APM_Weapon_PlasmaWhip</thing>
  </KCSG.SymbolDef>

  <KCSG.SymbolDef>
  <defName>APM_Mech_Vassal</defName>
  <pawnKindDef>APM_Mech_Vassal</pawnKindDef>
  <spawnPartOfFaction>True</spawnPartOfFaction>
  <numberToSpawn>1</numberToSpawn>
</KCSG.SymbolDef>

  <KCSG.SymbolDef>
  <defName>APM_Mech_Tinker</defName>
  <pawnKindDef>APM_Mech_Tinker</pawnKindDef>
  <spawnPartOfFaction>True</spawnPartOfFaction>
  <numberToSpawn>1</numberToSpawn>
</KCSG.SymbolDef>

  <KCSG.SymbolDef>
  <defName>APM_Mech_Lasher</defName>
  <pawnKindDef>APM_Mech_Lasher</pawnKindDef>
  <spawnPartOfFaction>True</spawnPartOfFaction>
  <numberToSpawn>1</numberToSpawn>
</KCSG.SymbolDef>

<KCSG.SymbolDef>
  <defName>APM_Mechanitor_Ancient</defName>
  <pawnKindDef>APM_Mechanitor_Ancient</pawnKindDef>
  <spawnPartOfFaction>false</spawnPartOfFaction>
  <faction>Ancients</faction>
  <numberToSpawn>1</numberToSpawn>
  <!-- Corpses are made by APM_SpawnScenarioCorpses, not by KCSG's spawnDead. KCSG kills the
       pawn before it is ever spawned, which skips normal corpse placement. -->
  <spawnRotten>true</spawnRotten>
  <spawnFilthAround>true</spawnFilthAround>
</KCSG.SymbolDef>

<KCSG.SymbolDef>
  <defName>Slave</defName>
  <pawnKindDef>Slave</pawnKindDef>
  <spawnPartOfFaction>false</spawnPartOfFaction>
  <faction>OutlanderRough</faction>
  <numberToSpawn>1</numberToSpawn>
  <!-- Corpses are made by APM_SpawnScenarioCorpses, not by KCSG's spawnDead. KCSG kills the
       pawn before it is ever spawned, which skips normal corpse placement. -->
  <spawnRotten>true</spawnRotten>
  <spawnFilthAround>true</spawnFilthAround>
</KCSG.SymbolDef>
</Defs>